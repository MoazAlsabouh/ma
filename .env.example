# MongoDB Connection String (Required)
# Use a free cluster from MongoDB Atlas, e.g., mongodb+srv://<user>:<pass>@cluster0.../study-dashboard
MONGO_URI=mongodb://localhost:27017/study-dashboard

# Email settings for sending verification codes (Required)
# If using Gmail, generate an App Password from your Google Account settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Session Secret (Required)
SESSION_SECRET=your_super_secret_session_key

# Port
PORT=3000
